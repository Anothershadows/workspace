package java_workout;

public class isprime_or_not {

	public static void main(String[] args) {

		int m = 13;
		int o = 0;
		for (int n = 2; n <= m; n++) {
			if (m % n == 0) {
				o++;
			}
		}
		if (o == 1) {
			System.out.println(m + " is prime number");
		} else {
			System.out.println(m + " not a prime");
		}

	}

}
