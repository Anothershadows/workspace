package javaqa;

public class rework {

	public static void main(String[] args) {
		int a = 70;
		int b = 0;
		for (int i = 2; i <= a / 2; i++) {
			if (a % i == 0) {
				b++;
			}
		}
		if (b == 0) {
			System.out.println(a + " ia prime number");
		}
		else {System.out.println(a + " ia not prime number");}
	}
}
